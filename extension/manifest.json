{
  "manifest_version": 3,
  "name": "ExtSecure",
  "version": "0.8.9",
  "description": "Browser security checks, explainable risk findings and controlled administrator workflows.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "declarativeNetRequest", "webNavigation", "alarms"],
  "optional_permissions": ["management"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "declarative_net_request": {"rule_resources":[{"id":"navigation","enabled":true,"path":"rules/navigation.json"}]},
  "web_accessible_resources": [{"resources":["blocked.html"],"matches":["http://*/*","https://*/*"]}],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "ExtSecure · Browser security", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "options_page": "console.html#settings",
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' data:; connect-src http://127.0.0.1:8765 http://localhost:8765; style-src 'self'"}
}
