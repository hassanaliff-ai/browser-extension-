# Copy to .env for the FastAPI process, then replace the blank required values.
# Keep .env private. The Streamlit dashboard needs only API_BASE_URL; its default
# already points at http://localhost:8000/monitor.

# Required by the original ExtSecure /scan lookup.
VT_API_KEY=
# Optional in-memory lookup TTL, in seconds (default: 600).
# CACHE_TTL_SECONDS=600

# Set all of these to enable protected monitoring at /monitor. The sign-in
# values can be generated with: python -m alba_security.admin_setup
# For local development, SQLite can be used: sqlite:///./extsecure.db
# Use PostgreSQL for deployment: postgresql+psycopg://user:password@localhost:5432/extsecure
DATABASE_URL=
# The primary account is the protected Head of Administrator.
# The setup tool defaults to head-of-administrator; keep existing configured
# primary credentials unchanged when upgrading an established deployment.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Optional independent administrator for policy review. Configure all three.
# This account must be approved by the Head of Administrator before sign-in.
# Generate separate values with python -m alba_security.admin_setup --reviewer.
ADMIN_REVIEWER_USERNAME=
ADMIN_REVIEWER_PASSWORD_HASH=
ADMIN_REVIEWER_TOTP_SECRET=
# Optional: set to 0 to keep monitoring unmounted even when all values above
# are configured. The original /scan API remains available.
# MONITORING_ENABLED=0

# Set a long random token for trusted external callers of monitoring ingestion.
# Never place it inside a distributed browser extension.
INGEST_TOKEN=

# AI explanations and weekly/monthly reports. Model must support Responses
# structured outputs. Keys remain in the backend; never add them to extension.
# Reports send aggregate counts. Optional bounded content requires UI consent.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional: monthly report emails and High/Critical threat alert emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# ADMIN_EMAILS=admin1@example.invalid,admin2@example.invalid

# Optional: High/Critical threat alert webhooks (HTTPS only).
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_URLS=https://one.example.invalid/hook,https://two.example.invalid/hook
# ALERT_WEBHOOK_SECRET=
# NOTIFICATION_TIMEOUT_SECONDS=10
# Optional dedicated Fernet key for registered-account authenticator encryption.
# Set before registering the first account and retain it with database backups.
# If blank, the key is derived from the primary ADMIN_TOTP_SECRET; preserve that
# secret to keep registered accounts readable. Changing either requires migration.
ADMIN_ACCOUNT_ENCRYPTION_KEY=
