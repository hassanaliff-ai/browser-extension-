# Copy to .env for the FastAPI process, then replace the blank required values.
# Keep .env private. The Streamlit dashboard needs only API_BASE_URL; its default
# already points at http://localhost:8000/monitor.

# Required by the original SecureScope /scan lookup.
VT_API_KEY=
# Optional in-memory lookup TTL, in seconds (default: 600).
# CACHE_TTL_SECONDS=600

# Set all of these to enable protected monitoring at /monitor. The sign-in
# values can be generated with: python -m alba_security.admin_setup
# For local development, SQLite can be used: sqlite:///./securescope.db
# Use PostgreSQL for deployment: postgresql+psycopg://user:password@localhost:5432/securescope
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Optional: set to 0 to keep monitoring unmounted even when all values above
# are configured. The original /scan API remains available.
# MONITORING_ENABLED=0

# Set a long random token for trusted external callers of monitoring ingestion.
# Never place it inside a distributed browser extension.
INGEST_TOKEN=

# Optional: monthly report generation sends aggregate counts to the LLM.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional: monthly report emails and High/Critical threat alert emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# ADMIN_EMAILS=admin1@example.invalid,admin2@example.invalid

# Optional: High/Critical threat alert webhooks (HTTPS only).
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_URLS=https://one.example.invalid/hook,https://two.example.invalid/hook
# ALERT_WEBHOOK_SECRET=
# NOTIFICATION_TIMEOUT_SECONDS=10
